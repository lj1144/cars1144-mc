options:
    prefix: <##12121D>&lᴅᴜᴘᴇ07 ≫<##A4A4C3>
    announcement-prefix: <##12121D>&lᴀɴɴᴏᴜɴᴄᴇᴍᴇɴᴛ ≫<##A4A4C3>

# =====
# =====
# =====

command /broadcast [<text>]:
	aliases: /announce
	permission: ezlavarising.broadcast
	trigger:
		if arg-1 is set:
			broadcast ""
			broadcast "{@announcement-prefix} %colored arg-1%"
			broadcast ""
			play sound "block.note_block.bit" at volume 1 at pitch 3 to all players

command /announce [<text>]:
    permission: ezlavarising.broadcast
    trigger:
        if arg-1 is set:
            make console execute command "/broadcast %arg-1%"

command /bc [<text>]:
    permission: ezlavarising.broadcast
    trigger:
        if arg-1 is set:
            make console execute command "/broadcast %arg-1%"

command /rename [<text>]:
    permission: dupe07.rename
    permission message: &cYes I am sorry I do not speak english. ok
    trigger:
        if arg-1 is set:
            if player's tool is not air:
                set name of player's tool to formatted "&r%colored arg-1%"
                send "{@prefix} Successfully renamed!" to player
                play sound "entity.player.levelup" at volume 1 at pitch 1.2 to player
				

command /shop:
    cooldown: 1 second
    trigger:
        make player execute command "/warp shop"


command /discord:
    trigger:
        send "{@prefix} Join the discord &f&l&n<link:https://discord.gg/pDARVhStJZ>discord.gg/pDARVhStJZ"

