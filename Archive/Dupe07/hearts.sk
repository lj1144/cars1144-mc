#A command to list all bounties




#A command to share hearts with other people



#---------------------------------- FUNCTION ----------------------------------#

on quit:
    if {hearts::%uuid of player%} is less than 11:
        delete {hearts::%uuid of player%}

#Updates the hearts of players. I used a function because its convinent and will be used alot
function updatehearts(p: player):
	#Does the changing and shit
	set {_u} to uuid of {_p}
	set {_p}'s maximum health to {hearts::%{_u}%}
	if {hearts::%{_u}%} is greater than 19:
		set {hearts::%{_u}%} to 20
		set {_p}'s maximum health to {hearts::%{_u}%}
	if {hearts::%{_u}%} is less than 10:
		set {hearts::%{_u}%} to 10
		set {_p}'s maximum health to {hearts::%{_u}%}

command /heartshop:
	trigger:
		create a gui with virtual chest inventory with 1 rows named "&c&lHeart Shop":
			set {_math} to {hearts::%uuid of player%} - 9
			set {_cost} to 500 * {_math}
			make gui slot 4 to chest named "&c&lHeart Container" with lore " ", "&cCost:&6 %{_cost}% Tokens":
				set {_tokens} to placeholder "beasttokens_tokens_raw" from player parsed as number
				if {_tokens} is greater than {_cost}:
					add 1 to {hearts::%uuid of player%}
					updatehearts(player)
					make console execute command "/ta remove %player% %{_cost}%"
					close player's inventory
				else:
					send "{@prefix} You do not have enough tokens!"
					close player's inventory
		open last gui to player
