#--------------------------------- FIRST RUNS ---------------------------------#

options:
    prefix: <##12121D>&lᴅᴜᴘᴇ07 ≫<##A4A4C3>

#Debug command to update all the hearts of online players
command /fixhearts:
    permission: op
    trigger:
        loop all players:
            updatehearts(loop-player)


on join:
    if {hearts::%player's uuid%} is not set:
        set {hearts::%player's uuid%} to 10
    if player's world is "manualevent":
        stop
    updatehearts(player)
on respawn:
    wait 1 ticks
    updatehearts(player)

on first join:
	set {hearts::%player's uuid%} to 10 
	updatehearts(player)


command heartserverreset:
	cooldown: 5 seconds
	trigger:
		command sender is console:
			broadcast "{@prefix} HEARTS WILL GLOBALLY RESET!"
			wait 3 seconds
			clear {hearts::*}
			wait 3 seconds
			broadcast "{@prefix} Please rejoin"
			loop all players:
				kick loop-player
		command sender is player:
			send "&cThis is a console only command!"

