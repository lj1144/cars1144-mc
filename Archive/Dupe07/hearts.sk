command /setheart <player> <integer>:
	permission: op
	trigger:
		set {hearts::%arg-1's uuid%} to arg-2
		updatehearts(arg-1)

on right click:
	if player's tool is enchanted with unbreaking 10:
		if player's tool is red dye:
			add 1 to {hearts::%player's uuid%}
			remove 1 of player's tool from player's inventory
			updatehearts(player)
	
