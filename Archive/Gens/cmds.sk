command /updatenotes [<text>]:
    permission: lotusgens.updates
    trigger:
        clear {updatenotes::msg::*}
        set {updatenotes::msg::*} to colored arg-1
        send "{@prefix} Set the update notes to %colored arg-1%"
        wait 1 second
        broadcast ""
        broadcast "{@prefix} &lUPDATE: %{updatenotes::msg::*}%"
        broadcast ""
        play sound "block.note_block.bit" at volume 1 at pitch 3 to player
        loop all players:
            add loop-player to {updatesnotes::*}

on chat:
  message contains "staff"
  {updatenotes::new::*} contains player
  send "{@prefix} Apply for staff using /application"

on first join:
    add uuid of player to {updatenotes::new::*}
    wait 30 seconds
    remove uuid of player from {updatenotes::new::*}
 
on join:
    if {updatenotes::new::*} contains uuid of player:
        stop
    if {updatesnotes::*} does not contain player:
        wait 5 seconds
        send ""
        send "{@prefix} &lUPDATE: %{updatenotes::msg::*}%"
        send ""
        play sound "block.note_block.bit" at volume 1 at pitch 3 to player
        add player to {updatesnotes::*}

