options:
    prefix: <##AB2330>&lᴇᴢʟᴀᴠᴀʀɪꜱɪɴɢ ≫<##A95F66>

on skript start:
    set {serverstatus} to "lobby"
    delete {servergame}
    delete {y}
    delete {game}
    delete {lava}
    set {gamevotetime} to false

command /fixserver:
    permission: ezlavarising.fixserver
    trigger:
        set {serverstatus} to "lobby"
        delete {servergame}
        delete {y}
        delete {game}
        set {gamevotetime} to false
        delete {lava}
        teleport all players to location(0, 103, 0, world("world"))
        loop all players:
            clear loop-player's inventory


command /mutechat:
    permission: ezlavarising.mutechat
    trigger:
        if {globalchat} is not set:
            set {globalchat} to true
            broadcast ""
            broadcast "{@prefix} Chat has been muted"
            broadcast ""
        else:
            delete {globalchat}
            broadcast ""
            broadcast "{@prefix} Chat has been unmuted"
            broadcast ""

on chat:
    if {globalchat} is set:
        if player has permission "ezlavarising.mutechat.bypass":
            stop
        cancel event
        send "{@prefix} Chat is currently disabled"

on join:
    join(player)

every 2.5 seconds:
    if {serverstatus} is "lobby":
        loop all players:
            send action bar "Next event will start at 3+ players" to loop-player
        set {playercountstart} to number of all players
        if {playercountstart} is greater than 1:
            restartlavarising()
            set {serverstatus} to "setup"
        delete {playercountstart}


on death of player:
    if victim is in world "lavarise":
        wait 1 second
        send title "&c&lYou Died" with subtitle "&cDw. There will be infinite rounds<3" to victim

command /startcheck:
    permission: op
    trigger:
        if {servergame} is not "pvp":
            kick player
        else:
            wait 9 seconds
            kick player

on region enter:
    wait 1 tick
    if "%region at player%" contains "infparkour":
        teleport player to location(0,100,0, world "world", -90, 0)
        wait 3 ticks
        make console execute command "/ip forcejoin %player%"

command /discord:
    trigger:
        send ""
        send "{@prefix} Join the discord &l&n<link:https://discord.gg/pDARVhStJZ>discord.gg/pDARVhStJZ"
        send ""

on join:
    if {servergame} is "pvp":
        wait 1.5 seconds
        send ""
        send "{@prefix} You joined a bit late, but dont worry! There will be more rounds. Type /pvplobby if youd like to go to a PvP arena!"
        send ""

on first join:
    wait 5 seconds
    send ""
    send "{@prefix} This is a lava rising server just incase you are wondering<3 And welcome to the server!"
    send ""
    wait 5 seconds
    send ""
    send "{@prefix} The objective is to be the last one standing when PvP is on. The prize is a free rank!"
    send ""

on world change:
 set player's flight state to false

command /broadcast [<text>]:
	aliases: /bc, /announce, /alert
	permission: ezlavarising.broadcast
	trigger:
		if arg-1 is set:
			broadcast ""
			broadcast "{@prefix} &l%colored arg-1%"
			broadcast ""
			play sound "block.note_block.bit" at volume 1 at pitch 3 to all players
command /bc [<text>]:
    permission: ezlavarising.broadcast
    trigger:
        if arg-1 is set:   
            make player execute command "/broadcast %arg-1%"

command /top:
    aliases: /stuck
    cooldown: 30 seconds
    trigger:
        {servergame} = "intro"
        set {_x} to round(random number between -50 and 50)
        set {_z} to round(random number between -50 and 50)
        teleport player to location({_x}, 200, {_z}, world "lavarise")

command /updatenotes [<text>]:
    permission: op
    trigger:
        clear {updatesnotes::*}
        set {updatenotes} to colored arg-1
        send "{@prefix} Set the update notes to %colored arg-1%"
        wait 1 second
        send ""
        send "{@prefix} &lUPDATE: %{updatenotes}%"
        send ""
        loop all players:
            add loop-player to {updatesnotes::*}

on first join:
    add uuid of player to {updatenotes::new::*}
    wait 30 seconds
    remove uuid of player from {updatenotes::new::*}

on join:
    if {updatenotes::new::*} contains uuid of player:
        stop
    if {updatesnotes::*} does not contain player:
        wait 5 seconds
        send ""
        send "{@prefix} &lUPDATE: %{updatenotes}%"
        send ""
        add player to {updatesnotes::*}

command /votegm [<text>]:
    trigger:
        if arg-1 is "check":
            if player is op:
                send "%{gamemodevote::players::*}% | Insane %{gamemodevote::mode::insane}% | Normal %{gamemodevote::mode::normal}% | Void  %{gamemodevote::mode::void}% | GAMEMODE: %{gamemode}%"
        if {gamevotetime} is false:
            send "&c&oIt is not time yet..."
            stop
        if {gamemodevote::players::*} contains uuid of player:
            send "{@prefix} You already voted!"
            stop
        create a gui with virtual chest inventory with 2 rows named "&c&lVOTE NEXT GAMEMODE":
            make gui slot 0 to "diamond sword" parsed as item named "&c&lNormal Mode" with lore "&5&oCLICK TO VOTE FOR NORMAL MODE":
                if player has permission "ezlavarising.premium":
                    add 4 to {gamemodevote::mode::normal}
                    add uuid of player to {gamemodevote::players::*}
                    close player's inventory
                    send "{@prefix} Since you have premium rank, your vote counted for 4 normal!"
                    if player is op:
                        add 44 to {gamemodevote::mode::normal}
#                        add uuid of player to {gamemodevote::players::*}
                        close player's inventory
                        send "{@prefix} Since you have op rank, your vote counted for 44 normal!"
                    stop
                add 1 to {gamemodevote::mode::normal}
                add uuid of player to {gamemodevote::players::*}
                close player's inventory
                send "{@prefix} You voted for normal mode!"
            make gui slot 1 to "netherite sword" parsed as item named "&4&lInsane Mode" with lore "&5&oCLICK TO VOTE FOR INSANE MODE":
                if player has permission "ezlavarising.premium":
                    add 4 to {gamemodevote::mode::insane}
                    add uuid of player to {gamemodevote::players::*}
                    close player's inventory
                    send "{@prefix} Since you have premium rank, your vote counted for 4 insane!"
                    stop
                add 1 to {gamemodevote::mode::insane}
                add uuid of player to {gamemodevote::players::*}
                close player's inventory
                send "{@prefix} You voted for insane mode!"
            make gui slot 2 to "barrier" parsed as item named "&f&lVoid Mode" with lore "&5&oCLICK TO VOTE FOR VOID MODE":
