on load:
    clear {modifiers::list::*}
    add "Random Items" to {modifiers::list::*}
    add "Fast lava" to {modifiers::list::*}

function randommodifier():
    clear {modifiers::active::*}

    

function resetvotegm():
    set {gamevotetime} to true
    clear {gamemodevote::players::*}
    clear {gamemodevote::mode::*}
#    set {gamemodevote::mode::insane} to 0
    set {gamemodevote::mode::normal} to 5
#    set {gamemodevote::mode::void} to 0
#    set {gamemodevote::mode::bull} to 0
#    set {gamemodevote::mode::lucky} to 0
#    set {gamemodevote::mode::random} to 0
#    set {gamemodevote::mode::chaos} to 0
#    set {gamemodevote::mode::hardcore} to 0
#    set {gamemodevote::mode::acid} to 0
#    set {gamemodevote::mode::ironage} to 0
#    delete {gamemodevote::mode::ironage::name}
#    delete {gamemodevote::mode::acid::name}
#    delete {gamemodevote::mode::harcore::name}
#    delete {gamemodevote::mode::insane::name}
    delete {gamemodevote::mode::normal::name}
#    delete {gamemodevote::mode::void::name}
#    delete {gamemodevote::mode::bull::name} 
#    delete {gamemodevote::mode::lucky::name}
#    delete {gamemodevote::mode::random::name}
#    delete {gamemodevote::mode::chaos::name}


function restartlavarising():
    set {serverstatus} to "setup"
    clear {tempused::*}
    make console execute command "/end"
    loop all players:
        teleport loop-player to location(0, 103, 0, world("world"))
        remove glowing from loop-player's active potion effects
        remove strength from loop-player's active potion effects
    loop all players:
        clear loop-player's inventory
    make console execute command "/effect clear @a"
    make console execute command "/execute in minecraft:lavarise run end"
    loop all players:
        clear loop-player's inventory

    # VOTE AND GAMEMODE
    resetvotegm()
#    broadcast ""
#    broadcast "{@prefix}&l PLEASE VOTE FOR THE NEXT GAMEMODE. USING &n&o/votegm"
#    broadcast ""
#    wait 1 second
#    loop all players:
#        if loop-player is not op:
#            make console execute command "sudo %loop-player% votegm"
#    wait 1 second
#    broadcast "{@prefix} VOTING ENDS IN 20 seconds"
#    wait 5 seconds
#    broadcast "{@prefix} VOTING ENDS IN 15 seconds"
#    wait 5 seconds
#    broadcast "{@prefix} VOTING ENDS IN 10 seconds"
#    wait 5 seconds
#    broadcast "{@prefix} VOTING ENDS IN 5 seconds"
#    wait 6 second
    finishrestart()

function finishrestart():
#    set {gamevotetime} to false
#    set {gamemodevote::mode::%{gamemode.last}%} to 0
    set {_gm::*} to sorted indices of {gamemodevote::mode::*} in descending order
#    broadcast "&c&lThe next gamemode is,"
#    wait 1 second
    set {_gm} to first element out of {_gm::*}
#    wait 1 second
#    set {gamemodevote::mode::acid::name} to "acid"
#    set {gamemodevote::mode::harcore::name} to "hardcore"
#    set {gamemodevote::mode::insane::name} to "insane"
    set {gamemodevote::mode::normal::name} to "normal"
#    set {gamemodevote::mode::void::name} to "void"
#    set {gamemodevote::mode::bull::name} to "antibull"
#    set {gamemodevote::mode::lucky::name} to "lucky"
#    set {gamemodevote::mode::random::name} to "random"
#    set {gamemodevote::mode::chaos::name} to "chaos"
#    set {gamemodevote::mode::ironage::name} to "ironage"
    broadcast "&c&l%{_gm}%"
    set {gamemode} to "%{_gm}%"
    set {gamemode.last} to "%{_gm}%"
    delete {failsave.2}
    wait 2 seconds
    make console execute command "/mv regen lavarise -s"
    broadcast "{@prefix} Resetting map w/ a new seed"
    wait 3 seconds
    make console execute command "/mv confirm"
    #broadcast "{@prefix} Please wait about 40 seconds to teleport. (This is to avoid crashing)"
    wait 10 seconds
    make console execute command "/execute in minecraft:lavarise run worldborder set 100"
    make console execute command "/execute in minecraft:lavarise run gamerule fallDamage false"
    make console execute command "/execute in minecraft:lavarise run gamerule doMobSpawning false"
    make console execute command "/execute in minecraft:lavarise run gamerule doImmediateRespawn true"
    make console execute command "/execute in minecraft:lavarise run gamerule randomTickSpeed 100"
    make console execute command "/rg flag __global__ -w lavarise pvp deny"
    make console execute command "/rg flag __global__ -w lavarise firespread deny"
    wait 6 seconds
    make console execute command "/ip forceleave everyone"
    wait 10 ticks
    set {serverstatus} to "game"
    loop all players:
        close loop-player's inventory
        kitmode(loop-player)
        set loop-player's gamemode to survival

    set {y} to 0
    teleport all players to location(0, 250, 0, world("lavarise"))
    clear {shoplimit::totem::*}
    wait 5 seconds
    loop all players:
        if loop-player is not in world "lavarise":
            teleport loop-player to location(0, 250, 0, world("lavarise"))
            close loop-player's inventory
            kitmode(loop-player)
    if highest solid block at location(0, 0, 0, world "lavarise") is water:
        broadcast "{@prefix} Water world detected. Giving extra blocks and placing village"
        wait 2 seconds
        give all players 192 of cobblestone
        give all players 64 of dirt
        wait 6 seconds
        make console execute command "/execute in minecraft:lavarise positioned 20 64 20 run place structure minecraft:village_plains"
        wait 2 seconds
        make console execute command "/execute in minecraft:lavarise positioned -20 64 -20 run place structure minecraft:mansion"
        broadcast "{@prefix} NOTE: Water world restarts have been dsiabled due to crashes"
    newround()
    gamestart()


function gamestart():
    set {servergame} to "intro"
    make console execute command "/rg flag -w lavarise __global__ tnt deny"
    make console execute command "/rg flag -w lavarise __global__ other-explosion deny"
    make console execute command "/rg flag -w lavarise __global__ pvp deny"
    make console execute command "/execute in minecraft:lavarise run gamerule fireDamage false"
    make console execute command "/execute in minecraft:lavarise run difficulty hard"
    make console execute command "/execute in minecraft:lavarise run gamerule announceAdvancements false"
    make console execute command "/execute in minecraft:lavarise run gamerule keepInventory true"
    make console execute command "/execute in minecraft:lavarise run difficulty peaceful"
    send title "<##A95F66>&lʟᴀᴠᴀ ʀɪꜱɪɴɢ ʀᴇᴄᴏᴅᴇᴅ | ʙʏ ᴄᴀʀꜱ1144" to all players
    set {lavaspeed} to 8
    broadcast "&7&l[&4&l&c&lezLavaRising&4&l&7&l] &a&lLava Rising Recoded | By cars1144"
    make console execute command "/execute in minecraft:lavarise run worldborder set 100"
    if {gamemode} is "void":
        make console execute command "/execute in minecraft:lavarise run worldborder set 75"
    wait 10 seconds
    broadcast "{@prefix} Lava will now start to rise"
    make console execute command "/execute in minecraft:lavarise run worldborder set 100"
    if {gamemode} is "void":
        make console execute command "/execute in minecraft:lavarise run worldborder set 75"
    send title "<##A95F66>&lLava is rising!" to all players
    make console execute command "/start"
    play sound "entity.wither.spawn" at volume 1 at pitch 2 to all players
    if {gamemode} is "lucky":
        make console execute command "/rg flag -w lavarise __global__ tnt allow"
        make console execute command "/rg flag -w lavarise __global__ other-explosion allow"
        make console execute command "/execute in minecraft:lavarise run difficulty hard"
        make console execute command "/execute in minecraft:lavarise run gamerule announceAdvancements false"
        make console execute command "/execute in minecraft:lavarise run gamerule keepInventory true"
        make console execute command "/execute in minecraft:lavarise run difficulty hard"


function pvpon():
    broadcast "{@prefix} PVP AND PERMADEATH IS NOW ON"
    set {servergame} to "pvp"
    clear {antibreak::*}
    send title "<##A95F66>&lPvP + Permadeath is now on!" to all players
    play sound "entity.wither.spawn" at volume 1 at pitch 2 to all players
    make console execute command "/rg flag -w lavarise __global__ pvp allow"
    make console execute command "/rg flag -w lavarise __global__ tnt allow"
    make console execute command "/rg flag -w lavarise __global__ other-explosion allow"
    make console execute command "/execute in minecraft:lavarise run gamerule fireDamage true"
    make console execute command "/execute in minecraft:lavarise run gamerule keepInventory false"
    make console execute command "execute in minecraft:lavarise run difficulty hard"
    liveset()
    loop all players:
        make console execute command "/effect clear %loop-player%"
    wait 3 seconds
    loop all players:
        if {bounty::%loop-player's uuid%} is set:
            apply glowing to loop-player for 9999 days
            add loop-player to {_bount}
    broadcast "{@prefix} Players with bounties: %{_bount}%"
    wait 3 second
    send title "<##A95F66>&lReminder: Max teams = 5" to all players
    broadcast "{@prefix} Reminder: Max teams = 5"



function join(p: player):
    wait 1 ticks
    remove glowing from {_p}'s active potion effects
    remove strength from {_p}'s active potion effects
    if {servergame} is "pvp":
        teleport {_p} to location(0, {y}+10, 0, world("lavarise"))
        set {_p}'s gamemode to spectator 
#        wait 8 seconds
#        resetpvp({_p})
        stop
    if {serverstatus} is "lobby" or "setup":
        resetpvp({_p})
        clear {_p}'s inventory
    else if {serverstatus} is "game":
        if {_p}'s world is "world" or "lobby":
            clear {_p}'s inventory
            teleport {_p} to highest solid block at location(0, 0, 0, world "lavarise")
            kitmode({_p})
            set {_p}'s gamemode to survival
            if {servergame} is "pvp":
                resetpvp({_p})
        else:
            if {servergame} is "pvp":
                resetpvp({_p})

on world change:
    wait 1 tick
    if player's world is "lavarise":
        set player's flight state to false

function kitmode(p: player):
    loop 3 times:
        clear {_p}'s inventory
        make console execute command "/xp set %{_p}% 0l"
        make console execute command "/clear %{_p}%"
        wait 1 second
    if {_p} has permission "ezlavarising.premium":
        give {_p} 24 of golden apple
        {gamemode} is not "chaos"
        give {_p} 1 of shulker box
    if {gamemode} is "normal" or "acid":
        make console execute command "/kit tools %{_p}%"
        stop
    if {gamemode} is "ironage":
        make console execute command "/kit ironage %{_p}%"
        stop
    else if {gamemode} is "insane":
        make console execute command "/kit insane %{_p}%"
        stop
    else if {gamemode} is "hardcore":
        make console execute command "/kit hardcore %{_p}%"
        stop
    else if {gamemode} is "void":
        make console execute command "/kit void %{_p}%"
        stop
    else if {gamemode} is "bull":
        make console execute command "/kit bull %{_p}%"
        stop
    else if {gamemode} is "chaos":
        make console execute command "/kit chaos %{_p}%"
        stop
    else if {gamemode} is "random" or "lucky":
        make console execute command "/kit random %{_p}%"
        if {gamemode} is "lucky":
            make console execute command "/luckyblock give %{_p}% YELLOW 24"
            make console execute command "/luckyblock give %{_p}% WHITE 24"
            make console execute command "/luckyblock give %{_p}% RED 24"
            make console execute command "/luckyblock give %{_p}% PURPLE 24"
            make console execute command "/luckyblock give %{_p}% PINK 24"
            make console execute command "/luckyblock give %{_p}% ORANGE 24"
            make console execute command "/luckyblock give %{_p}% MAGENTA 24"
            make console execute command "/luckyblock give %{_p}% LIME 24"
        stop
