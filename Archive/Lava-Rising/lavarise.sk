command /setlava <integer>:
    permission: op
    trigger:
        set {y} to arg-1
        send "&c&lLava has been set to %{y}%"

command /debuglava:
    permission: op
    trigger:
        send "%{lava}%"
        send "%{faster}%"
        send "%{y}%"
        send "&cLavaspeed: %{lavaspeed}%"
