on block form of obsidian:
    set event-block to coarse dirt

					



on player move:
    if player is in world "lavarise":
        if player's gamemode is spectator:
            if player's x coordinate is not between -80 and 80:
                teleport player to location(0, {y} + 10, 0, world("lavarise"))
					
on player move:
    if player is in world "lavarise":
        if player's gamemode is spectator:
            if player's z coordinate is not between -80 and 80:
                teleport player to location(0, {y} + 10, 0, world("lavarise"))

on player move:
    if player is in world "lavarise":
        if player's gamemode is spectator:
            if player's y coordinate is below -64:
                teleport player to location(0, {y} + 10, 0, world("lavarise"))
        else if player's gamemode is survival:
            if player's y coordinate is below -64:
                if {gamemode} is "void":
                    if {servergame} is "intro":
                        teleport player to location(0, 100, 0, world("lavarise"))
