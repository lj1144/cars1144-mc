options:
    prefix: <##AB2330>&lᴇᴢʟᴀᴠᴀʀɪꜱɪɴɢ ≫<##A95F66>
    color1: <##AB2330>
    color2: <##A95F66>

command /start:
 permission: ohakam.lol
 trigger:
  set {game} to true
  set {lava} to true
  delete {faster}
  set {y} to -24
  send "&aStarted Game"
  if {gamemode} is "broke":
   set {y} to -64
  if {gamemode} is "random":
   set {y} to 0

#on first join:
# {servergame} is not "pvp"
# {game} is true
# subtract 4 from {y}

command /end:
 permission: ohakam.lol
 trigger:
  delete {lava}
  delete {faster}
  send "&cEnded Game"

command /actionbar:
 cooldown: 5 seconds
 trigger:
  if {lavabar::*} contains player:
   remove player from {lavabar::*}
   send "&cLava messages will now be sent in chat"
  else:
   add player to {lavabar::*}
   send action bar "&cLava messages will now be sent in a action bar"

on load:
    set {lavaspeed} to 10

command /lavaspeed <integer>:
    permission: op
    trigger:
        set {lavaspeed.tick} to arg-1
        set {lavaspeed} to arg-1

every 3 minutes:
    {lava} is true
    {servergame} is "pvp"
    callenvoy()

every 2.5 minutes:
    {lava} is true
    {y} is less than 255
    {lavaspeed} is greater than -1
    {servergame} is "pvp"
    set {lavaspeed} to {lavaspeed}-1
    set {lavaspeed.tick} to {lavaspeed}
    broadcast ""
    broadcast "{@prefix} Lava speed has increased!"
    broadcast ""

every 1 second:
    {lava} is true
    {y} is less than 255
    if {lavaspeed.tick} is less than 1:
        console command "execute in minecraft:lavarise run fill 50 %{y}% -50 -50 %{y}% 50 lava replace air"
        console command "execute in minecraft:lavarise run fill 50 %{y}% -50 -50 %{y}% 50 lava replace water"
        loop all players:
            if {lavabar::*} does not contain loop-player:
                send "&cLava Raised! &o(Y = %{y}%)" to loop-player
            else:
                send action bar "&cLava Raised! &o(Y = %{y}%)" to loop-player
        autoevents()
        add 1 to {y}
        set {lavaspeed.tick} to {lavaspeed}
    else:
        if {lavaspeed.tick} is between -1 and {lavaspeed}+1:
            subtract 1 from {lavaspeed.tick}
        else:
            set {lavaspeed.tick} to {lavaspeed}



function autoevents():
    if {y} is equal to 100:
        console command "execute in minecraft:lavarise run worldborder set 40 1000"
    if {y} is equal to 140:
        if {gamemode} is not "void":
            set {faster} to true
            loop all players:
                if loop-player's gamemode is survival:
                    if {gamemode} is not "broke":
                        loop-player's world is "lavarise"
                        apply glowing 0 to loop-player for 1 day
                        apply strength 0 to loop-player for 1 day
    if {y} is equal to 252:
        loop all players:
            if loop-player's gamemode is survival:
                apply strength 2 to loop-player for 1 day
                broadcast "{@prefix} Teaming is no longer allowed"
                play sound "entity.wither.spawn" at volume 1 at pitch 2 to all players
                send title "<##A95F66>&lTeaming is no longer allowed" to all players
    if {y} is equal to 10:
        broadcast "{@prefix} PvP/Permdeath will be on at Y Level 70"
    if {y} is equal to 30:
        broadcast "{@prefix} PvP/Permdeath will be on at Y Level 70"
    if {y} is equal to 45:
        broadcast "{@prefix} PvP/Permdeath will be on at Y Level 70"
    if {y} is equal to 65:
        broadcast "{@prefix} PvP/Permdeath will be on in less than minutes"
    if {y} is equal to 70:
        pvpon()



